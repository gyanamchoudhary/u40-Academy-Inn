{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "u40-academy-inn",
  "account_id": "408f74ec91c62991098af4f5f8ab3e13",
  "main": "api/worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "host": "localhost",
  },
  "routes": [
    {
      "pattern": "u40academy.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.u40academy.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "u40-admissions",
      "database_id": "de66b6ed-bfbc-4c54-a213-304e63406474",
      "migrations_dir": "db/migrations",
    },
  ],
  "send_email": [
    {
      "name": "ADMISSIONS_EMAIL",
      "destination_address": "contact@u40academy.com",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "ADMISSION_RATE_LIMITER",
      "namespace_id": "40040",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
